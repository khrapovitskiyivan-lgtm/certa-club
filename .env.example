# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Домен сайта (без https://)
DOMAIN=certa-club.ru
# Полный адрес сайта: ссылки в письмах и вход по Face ID
CERTA_BASE_URL=https://certa-club.ru

# Пароль базы: любая длинная случайная строка (openssl rand -hex 24)
DB_PASSWORD=
# Секрет подписи входа: длинная случайная строка (openssl rand -hex 32). После смены все выйдут из клуба.
CERTA_SESSION_SECRET=

# Почта через Resend: ключ из resend.com, раздел API Keys
RESEND_API_KEY=
MAIL_FROM=Certa <club@certa-club.ru>
MAIL_REPLY_TO=info@certa-club.ru

# Первичная настройка (страница /setup, создаёт первое приглашение в совет). После настройки удалить.
CERTA_SETUP_TOKEN=
